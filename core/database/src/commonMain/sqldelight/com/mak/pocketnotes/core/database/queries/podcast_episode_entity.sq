CREATE TABLE IF NOT EXISTS `episodes` (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    listen_notes_url TEXT NOT NULL,
    thumbnail TEXT NOT NULL,
    image TEXT NOT NULL,
    audio TEXT NOT NULL,
    audio_length INTEGER NOT NULL,
    podcast_id TEXT NOT NULL,
    published_on INTEGER AS kotlin.time.Instant NOT NULL,
    next_episode_published_on INTEGER AS kotlin.time.Instant,
    FOREIGN KEY(`podcast_id`) REFERENCES `podcasts`(`id`) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS `index_episodes_podcast_id_published_on` ON `episodes` (`podcast_id`, `published_on` DESC, `id` ASC);

insert:
INSERT OR REPLACE INTO episodes (id, title, description, listen_notes_url, thumbnail, image, audio, audio_length, published_on, next_episode_published_on, podcast_id) VALUES ?;

getEpisodes:
SELECT * FROM episodes WHERE podcast_id =:podcastId;

getPaginatedEpisodes:
SELECT * FROM episodes WHERE podcast_id =:podcastId AND published_on <=:nextEpisodeDate LIMIT 10;

getEpisodesPaginated:
SELECT * FROM episodes WHERE podcast_id = :podcastId ORDER BY published_on DESC LIMIT :limit OFFSET :offset;

countEpisodes:
SELECT count(*) FROM episodes WHERE podcast_id = :podcastId;

getEpisodesKeyset:
SELECT * FROM episodes
WHERE podcast_id = :podcastId
AND published_on < :lastTimestamp
ORDER BY published_on DESC
LIMIT :limit;

getEpisodesInitial:
SELECT * FROM episodes
WHERE podcast_id = :podcastId
ORDER BY published_on DESC
LIMIT :limit;

getEpisodePageBoundaries:
SELECT published_on
FROM (
  SELECT
    published_on,
    CASE
      WHEN ((row_number() OVER(ORDER BY published_on DESC, id ASC) - 1) % :limit) = 0 THEN 1
      WHEN (:anchor IS NOT NULL AND published_on = :anchor) THEN 1
      ELSE 0
    END page_boundary
  FROM episodes
  WHERE podcast_id = :podcastId
)
WHERE page_boundary = 1
ORDER BY published_on DESC;

getEpisodesByBoundary:
SELECT * FROM episodes
WHERE podcast_id = :podcastId
AND published_on <= :beginInclusive
AND (published_on > :endExclusive OR :endExclusive IS NULL)
ORDER BY published_on DESC, id ASC;

deleteWithId:
DELETE FROM episodes WHERE podcast_id =:podcastId;

removeEpisode:
DELETE FROM episodes WHERE podcast_id=:podcastId AND published_on <=:nextEpisodeDate;

deleteAll:
DELETE FROM episodes;

getOldestEpisodeNextPageCursor:
SELECT next_episode_published_on FROM episodes WHERE podcast_id = :podcastId ORDER BY published_on ASC LIMIT 1;

getEpisodeById:
SELECT * FROM episodes WHERE id = :id;
