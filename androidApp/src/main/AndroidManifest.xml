<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".PocketCastApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_rounded_launcher"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--  OS specific configuration to let it know app need to be profileable  -->
        <profileable android:shell="true"/>

        <activity
            android:name=".AppMainActivity"
          android:exported="true"
          android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

          <!-- Custom Internal Actions -->
            <intent-filter>
                <action android:name="com.podcast.app.action.SHOW_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.podcast.app.action.SHOW_EPISODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.podcast.app.action.SHOW_QUEUE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

          <!-- App Links / Deep Links -->
          <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
            <data android:host="pocketnotes.mak.com" />

            <!-- Supported Paths -->
            <data android:pathPattern="/.*" />
            <data android:pathPrefix="/discover" />
            <data android:pathPrefix="/search" />
            <data android:pathPrefix="/subscribed" />
            <data android:pathPrefix="/settings" />
            <data android:pathPrefix="/podcast" />
            <data android:pathPrefix="/player" />
            <data android:pathPrefix="/queue" />
          </intent-filter>

          <!-- Custom Scheme (pocketnotes://) -->
          <intent-filter>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="pocketnotes" />
          </intent-filter>
        </activity>

        <service android:name="com.mak.pocketnotes.service.media.service.MediaPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- ── PodcastMediaService ──────────────────────────────────────── -->
        <!--
            foregroundServiceType="mediaPlayback" is required on Android 10+
            for audio playback in the background.

            The MediaLibraryService intent-filter lets Media3 / MediaController
            discover and connect to this service automatically.
        -->
        <service
            android:name=".media.PodcastMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">

            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.mak.pocketnotes.android.initializer.KoinInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
